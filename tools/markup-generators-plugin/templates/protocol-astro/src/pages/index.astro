---
import metadataJson from '../data/protocol.json';
import Layout from '../layouts/Layout.astro';
import type { ProtocolMetadata } from '../types';

const metadata = metadataJson as ProtocolMetadata;
---

<Layout title="Protocol index">
    <section class="masthead">
        <div>
            <h1>Network packets</h1>
            <p class="lede">The messages that shape Minecraft Bedrock network traffic, ordered by packet identifier.</p>
        </div>
    </section>

    <section class="directory-section" id="packets">
        <header class="section-heading"><p>01</p><div><h2>Packets</h2><span>Ordered by network identifier</span></div></header>
        <div class="packet-grid">
            {
                metadata.packets.map(packet => (
                    <a class="packet-card searchable" href={`/packets/${packet.slug}/`} data-search={packet.title.toLowerCase()}>
                        <span>{packet.id >= 0 ? packet.id : '—'}</span>
                        <div><strong>{packet.title}</strong><small>{packet.description}</small></div>
                        <i aria-hidden="true">→</i>
                    </a>
                ))
            }
        </div>
    </section>

</Layout>
