   ***************************************************************************** */
/**
 * @packageDocumentation
 *
 * Manifest Details
 * \`\`\`json
 * {
 *   "module_name": "@minecraft/generic-fixtures",
 *   "version": "1.0.0"
 * }
 * \`\`\`
 *
 */
import * as minecraftgenericbase from '@minecraft/generic-base';
export interface NativeClass<T> {
    readonly prototype: T;
}
export class BaseFixture {
    private constructor();
}

// @ts-ignore Class inheritance allowed for native defined classes
export class DerivedFixture extends BaseFixture {
    private constructor();
}

export class FixtureRegistry {
    private constructor();
    /**
     * @remarks
     * @privilege no-restricted-execution - This function can't be called in restricted-execution mode.
     *
     */
    static get<TFixture extends BaseFixture>(classType: NativeClass<TFixture>): TFixture | undefined;
    /**
     * @remarks
     * @privilege no-restricted-execution - This function can't be called in restricted-execution mode.
     *
     */
    static select<TItem extends BaseFixture>(items: TItem[]): TItem;
}

// @ts-ignore Class inheritance allowed for native defined classes
export class GenericDerived<TAlpha, TZebra> extends minecraftgenericbase.GenericBase<TZebra, TAlpha> {
    private constructor();
}

export class GenericFixture<TZebra extends minecraftgenericbase.CrossModuleBase, TAlpha = boolean> {
    private constructor();
    readonly pair: minecraftgenericbase.BasePair<TAlpha, TZebra>;
    readonly values: TZebra[];
}

export interface GenericInterface<TAlpha, TZebra> {
    convert<TAlpha, TZebra>(value: TZebra): TAlpha;
    getCurrent(): TAlpha;
}

/**
 * @remarks
 * @privilege no-restricted-execution - This function can't be called in restricted-execution mode.
 *
 */
export function pick<TAlpha, TZebra>(value: TZebra): TAlpha;
"
`;

